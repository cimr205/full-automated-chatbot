# Copy this to .env and fill in your values
# (START.bat does this for you automatically — you normally never edit this by hand)

# Railway Redis URL — find it in Railway under your Redis service → Connect
REDIS_URL=redis://default:password@your-railway-redis.railway.app:6379

# Path to your MT4 terminal's MQL4\Files folder
# Find it in MT4: File → Open Data Folder → MQL4 → Files (copy the folder path)
MT4_FILES_PATH=C:\Users\YourName\AppData\Roaming\MetaQuotes\Terminal\XXXXXXXX\MQL4\Files

# Lot size per trade (0.01 = micro lot)
MT4_LOT_SIZE=0.01

# Magic number — identifies trades placed by this bot
MT4_MAGIC=777000
