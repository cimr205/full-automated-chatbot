# ── Required ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Ollama (VPS or local) ─────────────────────────────────────────────────────
OLLAMA_URL=http://YOUR_VPS_IP:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_VISION_MODEL=qwen2.5vl

# ── Tuning ────────────────────────────────────────────────────────────────────
MAX_TASK_STEPS=25
HUMAN_REPLY_TIMEOUT=300
BROWSER_DATA_DIR=/tmp/browser-data

# ── Trading risk (account protection) ─────────────────────────────────────────
RISK_PER_TRADE_PCT=1            # % of equity risked per trade (used for lot sizing)
RISK_MAX_DAILY_LOSS_PCT=4       # halts new trades for the rest of the broker day
RISK_MAX_TOTAL_DRAWDOWN_PCT=8   # halts new trades until /unlock_risk
SIGNAL_CONFIDENCE=0.68          # hard floor — below this, signal is dropped
SIGNAL_CONFIRM_BAND=0.07        # signals within floor..floor+band need 2 confirming scans
SIGNAL_COOLDOWN=14400           # seconds before repeating a signal on the same symbol/direction
MONITOR_INTERVAL=600            # seconds between market scans

# ── Set automatically by docker-compose ──────────────────────────────────────
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/executor
CHROMA_HOST=chromadb
CHROMA_PORT=8000
