# Copy this to .env and fill in your values

# Railway Redis URL — find it in Railway under your Redis service → Connect
REDIS_URL=redis://default:password@your-railway-redis.railway.app:6379

# Lot size per trade (0.01 = micro lot)
MT5_LOT_SIZE=0.01

# Magic number — identifies trades placed by this bot
MT5_MAGIC=777000

# ── Kun hvis du kører som Railway-service (anbefalet — se RAILWAY_MT5_OPSAETNING.md) ──
# Disse er allerede sat som ENV i mt5_agent/Dockerfile for Railway-billedet.
# Lad dem stå udkommenteret her hvis du i stedet kører på din egen Windows-PC.
# MT5_BACKEND=linux
# MT5_LINUX_HOST=localhost
# MT5_LINUX_PORT=18812

# ── Auto-login (kræves for Railway — ingen manuel VNC/GUI-indlogning) ────────
# MT5_LOGIN=12345678
# MT5_PASSWORD=din-mt5-adgangskode
# MT5_SERVER=DinBroker-Demo
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ── Alternativ: gratis Linux-VPS uden Railway (Oracle Cloud Always Free) ─────
# Se OPSAET_GRATIS_VPS.md hvis du hellere vil køre uden om Railway.
