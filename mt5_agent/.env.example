# Copy this to .env and fill in your values

# Railway Redis URL — find it in Railway under your Redis service → Connect
REDIS_URL=redis://default:password@your-railway-redis.railway.app:6379

# Lot size per trade (0.01 = micro lot)
MT5_LOT_SIZE=0.01

# Magic number — identifies trades placed by this bot
MT5_MAGIC=777000

# Hvis din broker kalder guld noget andet end "XAUUSD" (fx "XAUUSDm",
# "GOLD", "GOLDmicro") — se symbolnavnet i MT5's "Market Watch" og sæt det her.
GOLD_SYMBOL=XAUUSD
